# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://machinemind:machinemind_pass@localhost:5432/machinemind
SYNC_DATABASE_URL=postgresql://machinemind:machinemind_pass@localhost:5432/machinemind

# ─── Groq LLM ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Uses sentence-transformers locally (no API key needed)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ─── File Storage (local for dev, S3-compatible for prod) ────────────────────
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# For S3:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_BUCKET_NAME=machinemind-documents
# AWS_REGION=us-east-1

# ─── Auth ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=500

# ─── RAG ─────────────────────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=8

# ─── Page rendering / figures ───────────────────────────────────────────────
# Page PNGs for citations live in {UPLOAD_DIR}/pages/{manual_id}/
PAGE_RENDER_DPI=150
# Figure detection: raster image area fraction, vector paths outside tables
FIGURE_IMAGE_AREA_RATIO=0.15
FIGURE_DRAWING_PATHS=100
# Max pages described by a vision model per manual
FIGURE_MAX_PAGES=12

# ─── Vision: multi-provider with automatic fallback ─────────────────────────
# auto | groq | gemini | openrouter | none
# auto = first provider with credentials (groq → gemini → openrouter);
# a provider returning 401/404 is parked for the rest of the process.
VISION_PROVIDER=auto
VISION_TIMEOUT_SECONDS=90
# Requires a vision-capable model on your Groq account (404 otherwise)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Gemini works on the free API tier (https://aistudio.google.com/apikey)
# gemini-2.0-flash was retired — use a current model (see `GET /v1beta/models`)
GEMINI_API_KEY=
# Verified vision models change over time — probe a few (e.g. gemini-3.6-flash,
# gemini-3.8-flash) or GET /v1beta/models to see what your key supports
GEMINI_VISION_MODEL=gemini-3.6-flash
# OpenRouter: cheap/free vision models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=meta-llama/llama-4-scout:free

# ─── OCR (local baseline, no API key needed) ─────────────────────────────────
# Transcribes scanned pages (needs_ocr) and figure pages when no vision
# provider is available. Requires the Tesseract binary (installed in the API
# Docker image; on Windows: `winget install UB-Mannheim.TesseractOCR` or
# point TESSERACT_CMD at tesseract.exe).
OCR_DPI=300
OCR_LANG=eng+fra
OCR_MAX_PAGES=50
TESSERACT_CMD=
