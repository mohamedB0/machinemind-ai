# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://machinemind:machinemind_pass@localhost:5432/machinemind
SYNC_DATABASE_URL=postgresql://machinemind:machinemind_pass@localhost:5432/machinemind

# ─── Groq LLM ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Embeddings ──────────────────────────────────────────────────────────────
# Uses sentence-transformers locally (no API key needed)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ─── File Storage (local for dev, S3-compatible for prod) ────────────────────
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# For S3:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_BUCKET_NAME=machinemind-documents
# AWS_REGION=us-east-1

# ─── Auth ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=500

# ─── RAG ─────────────────────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=8

# ─── Page rendering / figures ───────────────────────────────────────────────
# Page PNGs for citations live in {UPLOAD_DIR}/pages/{manual_id}/
PAGE_RENDER_DPI=150
# Figure detection: raster image area fraction, vector paths outside tables
FIGURE_IMAGE_AREA_RATIO=0.15
FIGURE_DRAWING_PATHS=100
# Max pages sent to the vision model per manual (ingest-time figure descriptions)
FIGURE_MAX_PAGES=12
# Must be a vision-capable model available to your Groq account
# (e.g. meta-llama/llama-4-scout-17b-16e-instruct on paid tiers)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
